<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" styleClass="root" xmlns:fx="http://javafx.com/fxml" 
      fx:controller="com.ticketflow.controller.MisComprasController">
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="← Ir al Inicio" onAction="#onIrAlInicio" styleClass="button-secondary"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Mis Compras" styleClass="title-label"/>
    </HBox>
    
    <Label text="Haz doble clic en una compra para ver sus detalles y descargar tickets." styleClass="subtitle-label"/>
    
    <TableView fx:id="tvCompras" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="150"/>
            <TableColumn fx:id="colEvento" text="Evento" prefWidth="250"/>
            <TableColumn fx:id="colTotal" text="Total ($)" prefWidth="120"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="120"/>
        </columns>
    </TableView>
    
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Pagar compra pendiente:" styleClass="subtitle-label"/>
        <ComboBox fx:id="cmbMetodoPago" promptText="Seleccionar método de pago" prefWidth="220" disable="true"/>
        <Button fx:id="btnPagar" text="Pagar" onAction="#onPagarCompra" styleClass="button-primary" disable="true"/>
        <Label fx:id="lblMensaje" style="-fx-text-fill: #ff6b6b;"/>
    </HBox>
</VBox>
